  "rules": [
    {
      "id": "common.purpose",
      "kind": "preference",
      "scope": {},
      "instruction": "Give each paragraph a clear purpose: information, explanation, an example or a useful transition.",
      "priority": 50,
      "enforcement": "human_review",
      "evidence_ids": [],
      "origin": "designed_default",
      "status": "REVIEWED"
    },
    {
      "id": "common.natural",
      "kind": "preference",
      "scope": {},
      "instruction": "Use concrete, natural wording appropriate to the reader; explain unfamiliar terms when needed.",
      "priority": 50,
      "enforcement": "human_review",
      "evidence_ids": [],
      "origin": "designed_default",
      "status": "REVIEWED"
    },
    {
      "id": "common.range",
      "kind": "preference",
      "scope": {},
      "instruction": "Vary pace as the task needs. Dashes, metaphor, humour and long sentences are available choices.",
      "priority": 50,
      "enforcement": "human_review",
      "evidence_ids": [],
      "origin": "designed_default",
      "status": "REVIEWED"
    },
    {
      "id": "common.restraint",
      "kind": "preference",
      "scope": {},
      "instruction": "Let useful detail carry emphasis; promotional excitement is optional.",
      "priority": 40,
      "enforcement": "human_review",
      "evidence_ids": [],
      "origin": "designed_default",
      "status": "REVIEWED"
    },
    {
      "id": "common.publishable-language",
      "kind": "constraint",
      "scope": {
        "languages": [
          "ru",
          "en"
        ],
        "registers": [
          "conversational",
          "essay",
          "fiction_narration",
          "maker_announcement"
        ],
        "channel": "all"
      },
      "instruction": "Use colloquial language without profanity or targeted insults; keep force through concrete wording.",
      "priority": 100,
      "enforcement": "human_review",
      "evidence_ids": [],
      "origin": "designed_default",
      "status": "REVIEWED",
      "required": true
    },
    {
      "id": "common.version-placement",
      "kind": "preference",
      "scope": {
        "languages": [
          "ru",
          "en"
        ],
        "registers": [
          "conversational",
          "essay",
          "maker_announcement"
        ],
        "channel": "narration"
      },
      "instruction": "Keep version codes out of a general-reader opening unless essential news; retain required versions in a technical note.",
      "priority": 85,
      "enforcement": "human_review",
      "evidence_ids": [],
      "origin": "designed_default",
      "status": "REVIEWED"
    },
    {
      "id": "common.vivid.entry",
      "kind": "preference",
      "scope": {
        "languages": [
          "ru",
          "en"
        ],
        "registers": [
          "conversational",
          "essay",
          "maker_announcement"
        ],
        "channel": "narration",
        "tags": [
          "delivery.vivid"
        ]
      },
      "instruction": "Start from a specific object, discrepancy or practical irritation. Develop its mechanism into a reader-facing consequence; give the post an angle rather than a catalogue of capabilities.",
      "priority": 75,
      "enforcement": "human_review",
      "evidence_ids": [],
      "origin": "designed_default",
      "status": "REVIEWED"
    },
    {
      "id": "common.vivid.humor",
      "kind": "preference",
      "scope": {
        "languages": [
          "ru",
          "en"
        ],
        "registers": [
          "conversational",
          "essay",
          "maker_announcement"
        ],
        "channel": "narration",
        "tags": [
          "delivery.vivid"
        ]
      },
      "instruction": "Use a precise dry observation or a fresh explanatory image when it earns its place. Let the image illuminate the mechanism, then return to it; avoid canned excitement or a punchline attached to every paragraph.",
      "priority": 60,
      "enforcement": "human_review",
      "evidence_ids": [],
      "origin": "designed_default",
      "status": "REVIEWED"
    },
    {
      "id": "common.vivid.texture",
      "kind": "preference",
      "scope": {
        "languages": [
          "ru",
          "en"
        ],
        "registers": [
          "conversational",
          "essay",
          "maker_announcement"
        ],
        "channel": "narration",
        "tags": [
          "delivery.vivid"
        ]
      },
      "instruction": "Let sentence lengths do different jobs: a brief observation can interrupt a connected explanation. Prefer visible actions and ordinary verbs to nominalized procedural language.",
      "priority": 60,
      "enforcement": "human_review",
      "evidence_ids": [],
      "origin": "designed_default",
      "status": "REVIEWED"
    },
    {
      "id": "common.vivid.scene",
      "kind": "preference",
      "scope": {
        "languages": [
          "ru",
          "en"
        ],
        "registers": [
          "fiction_narration"
        ],
        "channel": "narration",
        "tags": [
          "delivery.vivid"
        ]
      },
      "instruction": "Anchor a scene in actions and material detail. An incongruity can add humour when earned; keep the narrator and each character distinct.",
      "priority": 60,
      "enforcement": "human_review",
      "evidence_ids": [],
      "origin": "designed_default",
      "status": "REVIEWED"
    },
    {
      "id": "common.emoji.telegram",
      "kind": "preference",
      "scope": {
        "languages": [
          "ru",
          "en"
        ],
        "registers": [
          "conversational",
          "essay",
          "maker_announcement"
        ],
        "channel": "narration",
        "tags": [
          "social.telegram"
        ]
      },
      "instruction": "For Telegram, use zero to two fitting emoji when they add tone or navigation. A serious post can use none; no automatic emoji on every heading.",
      "priority": 80,
      "enforcement": "human_review",
      "evidence_ids": [],
      "origin": "designed_default",
      "status": "REVIEWED"
    },
    {
      "id": "common.emoji.x",
      "kind": "preference",
      "scope": {
        "languages": [
          "ru",
          "en"
        ],
        "registers": [
          "conversational",
          "essay",
          "maker_announcement"
        ],
        "channel": "narration",
        "tags": [
          "social.x"
        ]
      },
      "instruction": "For X, prefer zero or one relevant emoji and respect the supplied platform budget. Do not replace a necessary word or qualifier with a symbol.",
      "priority": 80,
      "enforcement": "human_review",
      "evidence_ids": [],
      "origin": "designed_default",
      "status": "REVIEWED"
    },
    {
      "id": "common.emoji.longform",
      "kind": "preference",
      "scope": {
        "languages": [
          "ru",
          "en"
        ],
        "registers": [
          "conversational",
          "essay",
          "maker_announcement"
        ],
        "channel": "narration",
        "tags": [
          "social.longform"
        ]
      },
      "instruction": "For long-form essays, reviews and documentation, use no emoji by default; add them only when the brief or established format calls for them.",
      "priority": 80,
      "enforcement": "human_review",
      "evidence_ids": [],
      "origin": "designed_default",
      "status": "REVIEWED"
    }
