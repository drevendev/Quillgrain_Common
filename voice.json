    {
      "authorship": "synthetic_ai_prepared",
      "before": "Условный сервис поддерживает сохранение прогноза погоды с меткой времени для последующего сопоставления показаний.",
      "channel": "narration",
      "id": "common.ru.v3.weather-snapshot",
      "language": "ru",
      "permissions": {
        "approved_model_hosts": [
          "offline",
          "chatgpt",
