        ],
        "channel": "narration",
        "tags": [
          "delivery.vivid"
        ]
      },
      "instruction": "Mix short reactions with enough connected explanation. Keep specialist nouns when useful and make the reasoning easy to follow.",
      "priority": 60,
      "enforcement": "human_review",
      "evidence_ids": [],
      "origin": "designed_default",
      "status": "REVIEWED"
    },
