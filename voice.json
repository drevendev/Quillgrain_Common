          "fiction_narration"
        ],
        "channel": "narration",
        "tags": [
          "delivery.vivid"
        ]
      },
      "instruction": "Anchor a scene in actions and material detail. An incongruity can add humour when earned; keep the narrator and each character distinct.",
      "priority": 60,
      "enforcement": "human_review",
      "evidence_ids": [],
      "origin": "designed_default",
      "status": "REVIEWED"
